{
  "name": "dsh-webseek",
  "version": "0.2.0",
  "description": "Imports a public DeepSeek share link as a real DSH session: one icon in the left sidebar, a dialog with the link and the target workspace, and a cold session with the same title.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "share",
    "import",
    "sidebar",
    "harness-plugin",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloQingTao/dsh-webseek.git"
  },
  "homepage": "https://github.com/HelloQingTao/dsh-webseek#readme",
  "bugs": {
    "url": "https://github.com/HelloQingTao/dsh-webseek/issues"
  },
  "author": "HelloQingTao",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./share": {
      "default": "./lib/share.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/share.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/images"
  ]
}
